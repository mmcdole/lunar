+func TestStringSubIdentityDoesNotChargeAllocationDebt(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		call string
+	}{
+		{name: "omitted end", call: "sub(text, 1)"},
+		{name: "negative end", call: "sub(text, 1, -1)"},
+		{name: "clamped bounds", call: "sub(text, -1000000, 1000000)"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			state := newStateWithString(t)
+			defer state.Close()
+			text := strings.Repeat("ab\x00d", 16<<10)
+			subject := state.String(text)
+			if err := state.RawSetGlobal("subject", subject); err != nil {
+				t.Fatal(err)
+			}
+			chunk := mustLoadString(t, state, "@string-sub-identity.lua",
+				"local sub, text = string.sub, subject\nreturn function() return "+test.call+" end")
+			body, err := state.CallOne(chunk.Value())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := state.CallOne(body); err != nil {
+				t.Fatal(err)
+			}
+			if err := state.StopGC(); err != nil {
+				t.Fatal(err)
+			}
+			before := state.runtime.collection.debt
+			for range 8 {
+				result, err := state.CallOne(body)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if got, ok := result.AsString(); !ok || got != text {
+					t.Fatal("identity substring did not preserve its text")
+				}
+				if !sameSlotRepresentation(slotFromValue(result), slotFromValue(subject)) {
+					t.Fatal("identity substring replaced its backing")
+				}
+			}
+			if after := state.runtime.collection.debt; after != before {
+				t.Fatalf("identity substring added %d bytes of allocation debt", after-before)
+			}
+		})
+	}
+}
