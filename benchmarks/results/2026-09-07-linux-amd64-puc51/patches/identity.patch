+func TestStringSubIdentityPreservesNumberCoercion(t *testing.T) {
+	state := newStateWithString(t)
+	defer state.Close()
+	chunk := mustLoadString(t, state, "@string-sub-number.lua", `
+return string.sub(12345, 1),
+       string.sub(12345, 1, -1),
+       string.sub(12345, -100, 100),
+       string.sub(12345, 2, 4)
+`)
+	results, err := state.Call(chunk.Value())
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertTestValues(t, results,
+		state.String("12345"), state.String("12345"),
+		state.String("12345"), state.String("234"))
+}
