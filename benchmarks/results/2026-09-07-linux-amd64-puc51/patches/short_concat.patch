+func TestExecutorConcatScratchBoundaryPreservesBacking(t *testing.T) {
+	state, err := New(Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer state.Close()
+	function := compileTestFunction(t, state, "@concat-scratch.lua", `
+local left, right = ...
+return left .. right
+`)
+	for _, length := range []int{63, 64, 65} {
+		left := strings.Repeat("x", length-1)
+		result, err := state.CallOne(function.owningValue(), state.String(left), state.String("\x00"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := state.CallOne(function.owningValue(), state.String(left), state.String("y")); err != nil {
+			t.Fatal(err)
+		}
+		if got, ok := result.AsString(); !ok || got != left+"\x00" {
+			t.Fatalf("%d-byte concatenation did not retain its original text", length)
+		}
+	}
+}
