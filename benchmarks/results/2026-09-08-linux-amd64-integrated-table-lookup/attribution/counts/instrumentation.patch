new file mode 100644
index 0000000..7337d50
--- /dev/null
+++ b/array_access_audit.go
@@ -0,0 +1,110 @@
+package lua
+
+import "math"
+
+// Private diagnostic instrumentation. Never use this build for timing.
+// Drivers audit one State at a time and exclude setup and result validation.
+type ArrayAccessCounts struct {
+	Total                  uint64 `json:"total"`
+	ExistingValue          uint64 `json:"existing_nonnil_array_value"`
+	AllocatedNil           uint64 `json:"allocated_nil_slot"`
+	StringMiss             uint64 `json:"nonnumeric_string"`
+	OtherKindMiss          uint64 `json:"nonnumeric_other"`
+	Zero                   uint64 `json:"numeric_zero"`
+	NegativeInteger        uint64 `json:"negative_integer"`
+	PositiveAboveLength    uint64 `json:"positive_integer_above_length"`
+	Fractional             uint64 `json:"fractional"`
+	Exceptional            uint64 `json:"nan_or_infinity"`
+	NextAfterLength        uint64 `json:"above_length_at_next_index_subset"`
+	WithinReservedCapacity uint64 `json:"above_length_within_capacity_subset"`
+	AboveArrayLimit        uint64 `json:"above_length_exceeds_array_limit_subset"`
+	WriteNil               uint64 `json:"write_nil_subset"`
+	ExistingValueWriteNil  uint64 `json:"existing_value_write_nil_subset"`
+}
+
+type ArrayAccessAuditSnapshot struct {
+	Reads  map[string]ArrayAccessCounts `json:"reads_by_caller"`
+	Writes ArrayAccessCounts            `json:"vm_writes"`
+}
+
+type arrayAuditCaller uint8
+
+const (
+	arrayAuditSharedOther arrayAuditCaller = iota
+	arrayAuditVMFast
+	arrayAuditVMSlow
+	arrayAuditNativeIndex
+	arrayAuditLuaRawGet
+	arrayAuditHostRawGet
+	arrayAuditCallerCount
+)
+
+var arrayAccessAudit struct {
+	enabled bool
+	reads   [arrayAuditCallerCount]ArrayAccessCounts
+	writes  ArrayAccessCounts
+}
+
+func StartArrayAccessAudit() {
+	arrayAccessAudit.enabled = false
+	clear(arrayAccessAudit.reads[:])
+	arrayAccessAudit.writes = ArrayAccessCounts{}
+	arrayAccessAudit.enabled = true
+}
+
+func StopArrayAccessAudit() ArrayAccessAuditSnapshot {
+	arrayAccessAudit.enabled = false
+	result := ArrayAccessAuditSnapshot{
+		Reads: make(map[string]ArrayAccessCounts), Writes: arrayAccessAudit.writes,
+	}
+	for index, name := range [...]string{
+		"shared_other", "vm_fast", "vm_slow", "native_frame_index", "lua_rawget", "host_rawget",
+	} {
+		result.Reads[name] = arrayAccessAudit.reads[index]
+	}
+	return result
+}
+
+func auditArrayAccess(counts *ArrayAccessCounts, table *tableObject, key slot, index int, accepted bool) {
+	counts.Total++
+	if accepted {
+		if table.array.at(index - 1).isNil() {
+			counts.AllocatedNil++
+		} else {
+			counts.ExistingValue++
+		}
+		return
+	}
+	if !key.isNumber() {
+		if key.isString() {
+			counts.StringMiss++
+		} else {
+			counts.OtherKindMiss++
+		}
+		return
+	}
+	number := math.Float64frombits(key.bits)
+	switch {
+	case math.IsNaN(number) || math.IsInf(number, 0):
+		counts.Exceptional++
+	case number == 0:
+		counts.Zero++
+	case math.Trunc(number) != number:
+		counts.Fractional++
+	case number < 0:
+		counts.NegativeInteger++
+	case number > float64(table.array.len()):
+		counts.PositiveAboveLength++
+		if number == float64(table.array.len()+1) {
+			counts.NextAfterLength++
+		}
+		if number <= float64(table.array.cap()) {
+			counts.WithinReservedCapacity++
+		}
+		if number > maximumTableArrayCapacity {
+			counts.AboveArrayLimit++
+		}
+	default:
+		panic("array audit: rejected exact positive index within logical length")
+	}
+}
diff --git a/array_access_audit_test.go b/array_access_audit_test.go
new file mode 100644
index 0000000..63bf454
--- /dev/null
+++ b/array_access_audit_test.go
@@ -0,0 +1,60 @@
+package lua
+
+import (
+	"math"
+	"testing"
+)
+
+func TestArrayAccessAuditCategoriesAndScope(t *testing.T) {
+	state, err := New(Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer state.Close()
+	table := newTable(state, 8, 0)
+	table.rawSetIntegerSlot(1, numberSlot(1))
+	table.rawSetIntegerSlot(3, numberSlot(3))
+	keys := []slot{
+		numberSlot(1), numberSlot(2), slotFromValue(state.String("name")), nilSlot,
+		numberSlot(0), numberSlot(-1), numberSlot(1.5), numberSlot(math.NaN()),
+		numberSlot(math.Inf(1)), numberSlot(4), numberSlot(7), numberSlot(1 << 40),
+	}
+	table.rawSlot(keys[0]) // Outside scope.
+	StartArrayAccessAudit()
+	for _, key := range keys {
+		table.rawSlotAudited(key, arrayAuditVMFast)
+	}
+	reads := StopArrayAccessAudit().Reads["vm_fast"]
+	want := ArrayAccessCounts{
+		Total: 12, ExistingValue: 1, AllocatedNil: 1, StringMiss: 1, OtherKindMiss: 1,
+		Zero: 1, NegativeInteger: 1, PositiveAboveLength: 3, Fractional: 1, Exceptional: 2,
+		NextAfterLength: 1, WithinReservedCapacity: 2, AboveArrayLimit: 1,
+	}
+	if reads != want {
+		t.Fatalf("read categories = %+v, want %+v", reads, want)
+	}
+	table.rawSlotAudited(keys[0], arrayAuditVMFast)
+	if after := StopArrayAccessAudit().Reads["vm_fast"]; after != reads {
+		t.Fatal("out-of-scope read changed counters")
+	}
+	function := &functionObject{prototype: &Prototype{}}
+	values := []slot{slotFromTableObject(table), numberSlot(1), numberSlot(9)}
+	StartArrayAccessAudit()
+	for _, write := range []struct {
+		key   int
+		value slot
+	}{
+		{1, numberSlot(9)}, {1, nilSlot}, {1, numberSlot(7)}, {4, numberSlot(4)}, {2, nilSlot},
+	} {
+		values[1], values[2] = numberSlot(float64(write.key)), write.value
+		if result := executeRawTableSet(values, function, 0, makeABC(opSetTable, 0, 1, 2)); result != tableInstructionHandled {
+			t.Fatalf("write returned %v", result)
+		}
+	}
+	writes := StopArrayAccessAudit().Writes
+	want = ArrayAccessCounts{Total: 5, ExistingValue: 2, AllocatedNil: 2, PositiveAboveLength: 1,
+		NextAfterLength: 1, WithinReservedCapacity: 1, WriteNil: 2, ExistingValueWriteNil: 1}
+	if writes != want {
+		t.Fatalf("write categories = %+v, want %+v", writes, want)
+	}
+}
