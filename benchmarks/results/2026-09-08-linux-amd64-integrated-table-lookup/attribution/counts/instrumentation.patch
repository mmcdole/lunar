--- /dev/null
+++ b/benchmarks/array_access_audit_test.go
@@ -0,0 +1,47 @@
+package compare
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+
+	lunar "github.com/mmcdole/lunar"
+)
+
+func TestArrayAccessAuditFannkuch(t *testing.T) {
+	output := os.Getenv("LUNAR_ARRAY_AUDIT_OUT")
+	if output == "" {
+		t.Skip("LUNAR_ARRAY_AUDIT_OUT not set")
+	}
+	spec, _ := findProgramSpec("fannkuchredux")
+	source, err := loadProgramSource(spec)
+	if err != nil {
+		t.Fatal(err)
+	}
+	prepared, err := prepareLunarProgram(spec, wrapProgramSource(source, 8))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer prepared.close()
+	lunar.StartArrayAccessAudit()
+	err = prepared.run()
+	counts := lunar.StopArrayAccessAudit()
+	if err != nil {
+		t.Fatal(err)
+	}
+	validatePreparedResult(t, prepared, programOracle{exact: "1616\nPfannkuchen(8) = 22\n"}, "audit")
+	result, err := prepared.result()
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := json.MarshalIndent(map[string]any{
+		"diagnostic_only": true, "workload": "fannkuchredux", "input": 8, "runs": 1,
+		"output": result, "audit": counts,
+	}, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(output, append(encoded, '\n'), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
